 export interface CheckoutOrder {
   id: string;
   items: Array<{ sku: string; qty: number; unitPrice: number }>;
+  couponPercent?: number;
 }
 
-export function priceOrder(order: CheckoutOrder): number {
-  return order.items.reduce((sum, item) => sum + item.qty * item.unitPrice, 0);
+export function priceOrder(order: CheckoutOrder, reply?: FastifyReply): number {
+  const subtotal = order.items.reduce((sum, item) => sum + item.qty * item.unitPrice, 0);
+  const discount = order.couponPercent ? (subtotal * order.couponPercent) / 100 : 0;
+  if (reply && subtotal === 0) {
+    reply.header("x-checkout-empty", "1");
+  }
+  return Math.round((subtotal - discount) * 100) / 100;
 }
 
