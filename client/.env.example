# @devdigest/web environment
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Port next dev listens on (the dev script reads it: `next dev -p ${WEB_PORT:-3000}`).
# The API reads the same variable to build its CORS allow-origin, so if you change
# it here, change it in server/.env too -- or just let scripts/dev.sh export it to
# both, which is what it does.
WEB_PORT=3000
