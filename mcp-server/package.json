{
  "name": "@devdigest/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server — local stdio server exposing reviewer agents, PR review runs, findings and repo conventions to MCP clients (Claude Code). A thin client of the DevDigest HTTP API; no DB access.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  }
}
