#!/usr/bin/env bash
# git pre-push hook — the same gate as the Claude Code PreToolUse hook, for pushes made
# from any terminal. `.git/hooks/` is not tracked, so install it once per clone:
#
#   ln -sf ../../.claude/hooks/pre-push .git/hooks/pre-push
#
# Scope and limits (plan §13.8): this covers local pushes only. It is bypassable with
# `git push --no-verify`, and it cannot stop a PR opened in the GitHub web UI. The gate
# that actually binds is CI, which does not exist yet.
set -uo pipefail

# Never gate a push that ONLY deletes refs (a delete carries an all-zero local sha).
# Exiting from inside the loop on the first delete would disable the gate for every other
# ref in the same push, so `git push origin :junk feat/x` would sail past un-reviewed.
has_real=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] || has_real=1
done
[ "$has_real" = 1 ] || exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
GATE="$ROOT/.claude/hooks/pr-gate.sh"
[ -x "$GATE" ] || exit 0

if ! "$GATE" gate; then
  printf '\nPush blocked by pr-self-review. Re-run /pr-self-review, or push with --no-verify\nif you are pushing work in progress that is not about to become a PR.\n' >&2
  exit 1
fi
exit 0
