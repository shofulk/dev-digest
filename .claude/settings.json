{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.sh check",
            "timeout": 15,
            "statusMessage": "pr-self-review gate"
          }
        ]
      }
    ]
  }
}
