{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.sh check",
            "timeout": 15,
            "statusMessage": "pr-self-review gate"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sdd-engineering@sdd-stable": true,
    "engineering-paved-path@sdd-stable": true,
    "research-tools@sdd-stable": true,
    "architecture-review@sdd-stable": true
  },
  "extraKnownMarketplaces": {
    "sdd-stable": {
      "source": {
        "source": "github",
        "repo": "shofulk/sdd-marketplace",
        "ref": "stable"
      }
    }
  }
}
